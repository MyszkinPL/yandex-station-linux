# Debian packages of the Station's root filesystem (scripts/build-rootfs.sh),
# on top of minbase. Only what the services and the boot use; each line says
# who needs it. Recommends are not installed.

# keeps our services running (os/station/start, os/station/sv)
runit
# network: init brings Wi-Fi up with these
wpasupplicant
iw
iproute2
# SSH (init starts it)
dropbear-bin
ca-certificates
curl
# Bluetooth speaker (os/station/sv: dbus, bluetoothd, bluealsa, bt-agent,
# bt-aplay; webd btplayer)
bluez
bluez-alsa-utils
bluez-tools
dbus
# busctl: webd reads the phone's player from BlueZ
systemd
# sound: amixer for the amplifiers and mics (init, audiod), aplay for playerd/audiod
alsa-utils
# time (os/station/sv/clock); zone files for the time zone (bin/timezone)
chrony
tzdata
# pgrep/pkill/ps (start, update, install-os), killall
procps
psmisc
# looking at the hardware when something is off
i2c-tools
e2fsprogs
less
