From: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
Subject: [PATCH] leds: add the Yandex Station LED ring

The ring has 24 RGB LEDs on two write-only SN3236 / IS31FL3236 36-channel
drivers on one I2C bus. Drive both chips as one device: 24 multicolor LED
class devices plus /dev/ledring, which takes a whole frame per write() and
latches it into both chips at once, so animations do not tear between the
two halves.

Signed-off-by: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
---
diff --git a/Documentation/devicetree/bindings/leds/yandex,station-led-ring.yaml b/Documentation/devicetree/bindings/leds/yandex,station-led-ring.yaml
new file mode 100644
index 0000000..7da10ad
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/yandex,station-led-ring.yaml
@@ -0,0 +1,63 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/yandex,station-led-ring.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Yandex Station LED ring (two SN3236 / IS31FL3236 on one I2C bus)
+
+maintainers:
+  - MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
+
+description: |
+  24 RGB LEDs driven by two write-only 36-channel constant-current LED
+  drivers. LEDs 1-12 sit on the chip at the first address, 13-24 on the
+  second; LED k of a chip uses OUT(3k-2) = green, OUT(3k-1) = red,
+  OUT(3k) = blue. The whole ring is one device, so a frame can be latched
+  into both chips at once.
+
+properties:
+  compatible:
+    const: yandex,station-led-ring
+
+  reg:
+    items:
+      - description: chip with LEDs 1-12
+      - description: chip with LEDs 13-24
+
+  reg-names:
+    items:
+      - const: leds1-12
+      - const: leds13-24
+
+  enable-gpios:
+    maxItems: 1
+    description: switch of the chips' VCC (SN3236_VCC_ENABLE)
+
+  shutdown-gpios:
+    maxItems: 2
+    description: SDB pins of the chips (hardware shutdown, active low)
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        led-ring@3f {
+            compatible = "yandex,station-led-ring";
+            reg = <0x3f>, <0x3c>;
+            reg-names = "leds1-12", "leds13-24";
+            enable-gpios = <&pio 3 10 GPIO_ACTIVE_HIGH>;
+            shutdown-gpios = <&pio 3 6 GPIO_ACTIVE_LOW>,
+                             <&pio 3 7 GPIO_ACTIVE_LOW>;
+        };
+    };
