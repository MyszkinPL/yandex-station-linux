From: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
Subject: [PATCH] selinux: fall back to the Android 6 ioctl rule layout for v30 policies

Android 6 (M) shipped policy version 30 with the pre-upstream ioctl
whitelisting format of its 3.10/3.18 kernels: an operation rule is the
avtab key, one type byte and the 256-bit permission map, and whole-type
rules use their own specifier bits (0x1000-0x4000). Upstream v30 stores
a specifier byte and a driver byte instead, so an M policy (e.g. on the
Yandex Station 1) does not load: "avtab: unsupported xperm specifier
0x8b" (0x8b is the type byte, wireless ioctls), then garbage, and init
reboots. Android 7 and later write the upstream layout.

The information is the same: an M operation rule is
AVTAB_XPERMS_IOCTLFUNCTION with the type as driver, a whole-type rule is
AVTAB_XPERMS_IOCTLDRIVER. A single rule does not tell the layouts apart,
so read every policy as upstream first and, only for a v30 policy that
failed with -EINVAL, read it again converting M rules. policydb_read()
starts from scratch and cleans up on failure, so the retry cannot see
state from the first attempt, and a failed retry returns the first error.

Signed-off-by: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
---
--- a/security/selinux/ss/policydb.h
+++ b/security/selinux/ss/policydb.h
@@ -318,6 +318,8 @@
 struct policy_file {
 	char *data;
 	size_t len;
+	/* read v30 ioctl rules in the Android 6 layout, see avtab_read_item() */
+	bool android_m_avtab;
 };
 
 extern void policydb_destroy(struct policydb *p);
--- a/security/selinux/ss/avtab.c
+++ b/security/selinux/ss/avtab.c
@@ -336,6 +336,22 @@
 };
 /* clang-format on */
 
+/*
+ * Android 6 (M) shipped policy version 30 with the pre-upstream ioctl
+ * whitelisting format of its kernels: an "operation" rule is the key, one
+ * type byte and the 256-bit permission map, and whole-type rules have their
+ * own specifier bits. Upstream v30 stores a specifier and a driver byte
+ * instead. Both carry the same information:
+ *   OPNUM  (0x0100/0x0200/0x0400): type = driver, map over the function
+ *          byte, i.e. AVTAB_XPERMS_IOCTLFUNCTION;
+ *   OPTYPE (0x1000/0x2000/0x4000): map over the driver byte, i.e.
+ *          AVTAB_XPERMS_IOCTLDRIVER.
+ * Android 7 and later write the upstream layout. The two cannot be told
+ * apart from a single rule, so security_load_policy() only reads a v30
+ * policy this way after the upstream layout failed to parse.
+ */
+#define AVTAB_ANDROID_M_OPTYPE 0x7000
+
 int avtab_read_item(struct avtab *a, struct policy_file *fp, struct policydb *pol,
 		    int (*insertf)(struct avtab *a, const struct avtab_key *k,
 				   const struct avtab_datum *d, void *p),
@@ -350,6 +366,7 @@
 	__le32 buf32[ARRAY_SIZE(xperms.perms.p)];
 	int rc;
 	unsigned int vers = pol->policyvers;
+	bool m_op = false, m_optype = false;
 
 	memset(&key, 0, sizeof(struct avtab_key));
 	memset(&datum, 0, sizeof(struct avtab_datum));
@@ -452,6 +469,16 @@
 	key.target_class = le16_to_cpu(buf16[items++]);
 	key.specified = le16_to_cpu(buf16[items++]);
 
+	if (fp->android_m_avtab && vers == POLICYDB_VERSION_XPERMS_IOCTL &&
+	    (key.specified & (AVTAB_XPERMS | AVTAB_ANDROID_M_OPTYPE))) {
+		m_op = true;
+		if (key.specified & AVTAB_ANDROID_M_OPTYPE) {
+			m_optype = true;
+			key.specified = (key.specified & ~AVTAB_ANDROID_M_OPTYPE) |
+					((key.specified & AVTAB_ANDROID_M_OPTYPE) >> 4);
+		}
+	}
+
 	if (!policydb_type_isvalid(pol, key.source_type) ||
 	    !policydb_type_isvalid(pol, key.target_type) ||
 	    !policydb_class_isvalid(pol, key.target_class)) {
@@ -485,6 +512,19 @@
 		return -EINVAL;
 	} else if (key.specified & AVTAB_XPERMS) {
 		memset(&xperms, 0, sizeof(struct avtab_extended_perms));
+		if (m_op) {
+			u8 type;
+
+			rc = next_entry(&type, fp, sizeof(u8));
+			if (rc) {
+				pr_err("SELinux: avtab: truncated entry\n");
+				return rc;
+			}
+			xperms.specified = m_optype ? AVTAB_XPERMS_IOCTLDRIVER :
+						      AVTAB_XPERMS_IOCTLFUNCTION;
+			xperms.driver = m_optype ? 0 : type;
+			goto read_perms;
+		}
 		rc = next_entry(&xperms.specified, fp, sizeof(u8));
 		if (rc) {
 			pr_err("SELinux: avtab: truncated entry\n");
@@ -499,6 +539,7 @@
 			pr_err("SELinux: avtab: truncated entry\n");
 			return rc;
 		}
+read_perms:
 		rc = next_entry(buf32, fp,
 				sizeof(u32) * ARRAY_SIZE(xperms.perms.p));
 		if (rc) {
--- a/security/selinux/ss/services.c
+++ b/security/selinux/ss/services.c
@@ -2303,6 +2303,24 @@
  * This function will flush the access vector cache after
  * loading the new policy.
  */
+/*
+ * The header's policy version: magic, string length, string, version.
+ * Used only to decide whether the Android 6 fallback applies.
+ */
+static u32 policy_header_version(const void *data, size_t len)
+{
+	const __le32 *p = data;
+	u32 slen, vers;
+
+	if (len < 3 * sizeof(u32))
+		return 0;
+	slen = le32_to_cpu(p[1]);
+	if (slen > len - 3 * sizeof(u32))
+		return 0;
+	memcpy(&vers, (const char *)data + 2 * sizeof(u32) + slen, sizeof(vers));
+	return le32_to_cpu((__force __le32)vers);
+}
+
 int security_load_policy(void *data, size_t len,
 			 struct selinux_load_state *load_state)
 {
@@ -2323,6 +2341,16 @@
 	}
 
 	rc = policydb_read(&newpolicy->policydb, fp);
+	if (rc == -EINVAL &&
+	    policy_header_version(data, len) == POLICYDB_VERSION_XPERMS_IOCTL) {
+		/* maybe Android 6: same version, other ioctl rule layout */
+		struct policy_file retry = { data, len, true };
+
+		if (!policydb_read(&newpolicy->policydb, &retry)) {
+			pr_info("SELinux:  policy read with the Android 6 ioctl rule layout\n");
+			rc = 0;
+		}
+	}
 	if (rc)
 		goto err_sidtab;
 
