index 55a9fea..67f212f 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -237,6 +237,26 @@ config MFD_AXP20X_RSB
 	  components like regulators or the PEK (Power Enable Key) under the
 	  corresponding menus.
 
+config MFD_AXP20X_ATF
+	tristate "X-Powers AXP803 behind the Allwinner BSP ARM Trusted Firmware"
+	depends on ARM64 && OF && HAVE_ARM_SMCCC
+	select MFD_AXP20X
+	select REGMAP
+	help
+	  Say Y here to reach an AXP803 PMIC through the register access
+	  calls of the Allwinner BSP BL31, as found on A64/R18 devices whose
+	  R_RSB bus is owned by the AR100 (SCP) firmware, e.g. the Yandex
+	  Station. Writes are refused unless the allow_writes parameter is
+	  set, and even then only the DLDO1/DLDO4 enable bits may change.
+
+config AXP803_ATF_PEEK
+	tristate "Read-only AXP803 register dump through the Allwinner BSP BL31"
+	depends on ARM64 && OF && HAVE_ARM_SMCCC && DEBUG_FS
+	help
+	  Test module for the Yandex Station: logs a snapshot of the AXP803
+	  regulator and power control registers through the BL31 PMIC read
+	  call and repeats it from debugfs. It has no write path.
+
 config MFD_CGBC
 	tristate "Congatec Board Controller"
 	select MFD_CORE
