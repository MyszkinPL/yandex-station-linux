From: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
Subject: [PATCH] reset: gpio: support GPIO controllers with more than two cells

The reset-gpios fallback of the reset core only takes specifiers of two
cells, <number flags>, and gives up with -ENOENT on anything else. The
Allwinner pin controllers use three, <bank pin flags>, so with
CONFIG_RESET_GPIO no reset-gpios line on these SoCs can be had through
the reset framework. Worse, the -ENOENT reaches optional getters too:
mmc-pwrseq-simple asks for its single reset-gpios line that way when
CONFIG_RESET_GPIO is set and only falls back to plain GPIOs on NULL, so
it fails to probe and the SDIO Wi-Fi behind it never shows up (seen on
the Yandex Station, sun50i-a64).

Translate other layouts with the GPIO chip's own OF translation, as
gpiolib does for its consumers, and let the reset-gpio controller take
as many cells as the specifier it was made for.

Signed-off-by: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
---
--- a/drivers/reset/core.c
+++ b/drivers/reset/core.c
@@ -1005,6 +1005,47 @@
 	       !memcmp(left->args, right->args, sizeof(left->args[0]) * left->nargs);
 }
 
+#ifdef CONFIG_OF_GPIO
+/*
+ * Chip-relative number and OF flags of a GPIO specifier that is not the
+ * usual <number flags>, e.g. the <bank pin flags> of Allwinner pin
+ * controllers: the GPIO chip translates it, as it does for gpiolib.
+ */
+static int reset_gpio_chip_xlate(struct gpio_device *gdev,
+				 const struct fwnode_reference_args *args,
+				 unsigned int *offset, unsigned int *flags)
+{
+	struct gpio_chip *gc = gpio_device_get_chip(gdev);
+	struct of_phandle_args spec = { };
+	u32 of_flags = 0;
+	int i, ret;
+
+	if (!is_of_node(args->fwnode) || !gc || !gc->of_xlate ||
+	    gc->of_gpio_n_cells != args->nargs || args->nargs > MAX_PHANDLE_ARGS)
+		return -ENOENT;
+
+	spec.np = to_of_node(args->fwnode);
+	spec.args_count = args->nargs;
+	for (i = 0; i < args->nargs; i++)
+		spec.args[i] = args->args[i];
+
+	ret = gc->of_xlate(gc, &spec, &of_flags);
+	if (ret < 0)
+		return ret;
+
+	*offset = ret;
+	*flags = of_flags;
+	return 0;
+}
+#else
+static int reset_gpio_chip_xlate(struct gpio_device *gdev,
+				 const struct fwnode_reference_args *args,
+				 unsigned int *offset, unsigned int *flags)
+{
+	return -ENOENT;
+}
+#endif
+
 /*
  * @np: OF-node associated with the consumer
  * @args: Reference to the GPIO provider with all the args like GPIO number
@@ -1019,23 +1060,31 @@
 	int ret, prop = 0;
 
 	/*
-	 * Currently only #gpio-cells=2 is supported with the meaning of:
-	 * args[0]: GPIO number
-	 * args[1]: GPIO flags
-	 * TODO: Handle other cases.
-	 */
-	if (args->nargs != 2)
-		return -ENOENT;
-
-	/*
 	 * Registering reset-gpio device might cause immediate
 	 * bind, resulting in its probe() registering new reset controller thus
 	 * taking reset_list_mutex lock via reset_controller_register().
 	 */
 	lockdep_assert_not_held(&reset_list_mutex);
 
-	offset = args->args[0];
-	flags = args->args[1];
+	struct gpio_device *gdev __free(gpio_device_put) =
+			gpio_device_find_by_fwnode(args->fwnode);
+	if (!gdev)
+		return -EPROBE_DEFER;
+
+	/*
+	 * #gpio-cells=2 means:
+	 * args[0]: GPIO number
+	 * args[1]: GPIO flags
+	 * Other layouts are translated by the GPIO chip.
+	 */
+	if (args->nargs == 2) {
+		offset = args->args[0];
+		flags = args->args[1];
+	} else {
+		ret = reset_gpio_chip_xlate(gdev, args, &offset, &flags);
+		if (ret)
+			return ret;
+	}
 
 	/*
 	 * Later we map GPIO flags between OF and Linux, however not all
@@ -1051,11 +1100,6 @@
 		return -EINVAL;
 	}
 
-	struct gpio_device *gdev __free(gpio_device_put) =
-			gpio_device_find_by_fwnode(args->fwnode);
-	if (!gdev)
-		return -EPROBE_DEFER;
-
 	guard(mutex)(&reset_gpio_lookup_mutex);
 
 	list_for_each_entry(rgpio_dev, &reset_gpio_lookup_list, list) {
--- a/drivers/reset/reset-gpio.c
+++ b/drivers/reset/reset-gpio.c
@@ -55,6 +55,7 @@
 			    const struct auxiliary_device_id *id)
 {
 	struct device *dev = &adev->dev;
+	const struct fwnode_reference_args *spec = dev_get_platdata(dev);
 	struct reset_gpio_priv *priv;
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
@@ -71,7 +72,7 @@
 	priv->rc.dev = dev;
 
 	/* Cells to match GPIO specifier, but it's not really used */
-	priv->rc.fwnode_reset_n_cells = 2;
+	priv->rc.fwnode_reset_n_cells = spec->nargs;
 	priv->rc.fwnode_xlate = reset_gpio_fwnode_xlate;
 	priv->rc.nr_resets = 1;
 
