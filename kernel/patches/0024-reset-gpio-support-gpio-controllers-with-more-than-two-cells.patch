From: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
Subject: [PATCH] reset: gpio: support GPIO controllers with more than two cells

The reset-gpios fallback of the reset core only takes specifiers of two
cells, <number flags>, and gives up with -ENOENT on anything else. The
Allwinner pin controllers use three, <bank pin flags>, so with
CONFIG_RESET_GPIO no reset-gpios line on these SoCs can be had through
the reset framework. Worse, the -ENOENT reaches optional getters too:
mmc-pwrseq-simple asks for its single reset-gpios line that way when
CONFIG_RESET_GPIO is set and only falls back to plain GPIOs on NULL, so
it fails to probe and the SDIO Wi-Fi behind it never shows up (seen on
the Yandex Station, sun50i-a64).

Translate other layouts with the GPIO chip's own OF translation, as
gpiolib does for its consumers, and let the reset-gpio controller take
as many cells as the specifier it was made for.

Signed-off-by: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
---
--- a/drivers/reset/core.c
+++ b/drivers/reset/core.c
@@ -903,20 +903,65 @@
 /*
  * @args:	phandle to the GPIO provider with all the args like GPIO number
  */
+#ifdef CONFIG_OF_GPIO
+/*
+ * Chip-relative number and OF flags of a GPIO specifier that is not the
+ * usual <number flags>, e.g. the <bank pin flags> of Allwinner pin
+ * controllers: the GPIO chip translates it, as it does for gpiolib.
+ */
+static int reset_gpio_chip_xlate(const struct of_phandle_args *args,
+				 unsigned int *offset, unsigned int *flags)
+{
+	struct gpio_device *gdev __free(gpio_device_put) =
+			gpio_device_find_by_fwnode(of_fwnode_handle(args->np));
+	struct gpio_chip *gc;
+	u32 of_flags = 0;
+	int ret;
+
+	if (!gdev)
+		return -EPROBE_DEFER;
+
+	gc = gpio_device_get_chip(gdev);
+	if (!gc || !gc->of_xlate || gc->of_gpio_n_cells != args->args_count)
+		return -ENOENT;
+
+	ret = gc->of_xlate(gc, args, &of_flags);
+	if (ret < 0)
+		return ret;
+
+	*offset = ret;
+	*flags = of_flags;
+	return 0;
+}
+#else
+static int reset_gpio_chip_xlate(const struct of_phandle_args *args,
+				 unsigned int *offset, unsigned int *flags)
+{
+	return -ENOENT;
+}
+#endif
+
 static int __reset_add_reset_gpio_device(const struct of_phandle_args *args)
 {
 	struct reset_gpio_lookup *rgpio_dev;
 	struct platform_device *pdev;
+	unsigned int offset, flags;
 	int id, ret;
 
 	/*
-	 * Currently only #gpio-cells=2 is supported with the meaning of:
+	 * #gpio-cells=2 means:
 	 * args[0]: GPIO number
 	 * args[1]: GPIO flags
-	 * TODO: Handle other cases.
+	 * Other layouts are translated by the GPIO chip.
 	 */
-	if (args->args_count != 2)
-		return -ENOENT;
+	if (args->args_count == 2) {
+		offset = args->args[0];
+		flags = args->args[1];
+	} else {
+		ret = reset_gpio_chip_xlate(args, &offset, &flags);
+		if (ret)
+			return ret;
+	}
 
 	/*
 	 * Registering reset-gpio device might cause immediate
@@ -945,8 +990,7 @@
 		goto err_ida_free;
 	}
 
-	ret = __reset_add_reset_gpio_lookup(id, args->np, args->args[0],
-					    args->args[1]);
+	ret = __reset_add_reset_gpio_lookup(id, args->np, offset, flags);
 	if (ret < 0)
 		goto err_kfree;
 
--- a/drivers/reset/reset-gpio.c
+++ b/drivers/reset/reset-gpio.c
@@ -92,7 +92,7 @@
 		return ret;
 
 	/* Cells to match GPIO specifier, but it's not really used */
-	priv->rc.of_reset_n_cells = 2;
+	priv->rc.of_reset_n_cells = platdata->args_count;
 	priv->rc.of_xlate = reset_gpio_of_xlate;
 	priv->rc.nr_resets = 1;
 
