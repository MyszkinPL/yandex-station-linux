 #include <sound/tlv.h>
@@ -36,20 +41,30 @@
 struct tas571x_chip {
 	const char			*const *supply_names;
 	int				num_supply_names;
+	/*
+	 * Power stage supply that must only come up after the digital
+	 * supplies are stable and RST has been released (optional).
+	 */
