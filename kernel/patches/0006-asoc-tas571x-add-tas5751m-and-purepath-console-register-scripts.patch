+++ b/Documentation/devicetree/bindings/sound/ti,tas57xx.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/sound/ti,tas57xx.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Texas Instruments TAS5711/TAS5717/TAS5719/TAS5721 stereo power amplifiers
+title: Texas Instruments TAS57xx stereo power amplifiers
 
 maintainers:
   - Neil Armstrong <neil.armstrong@linaro.org>
@@ -18,6 +18,7 @@ properties:
       - ti,tas5719
       - ti,tas5721
       - ti,tas5733
+      - ti,tas5751m
       - ti,tas5753
 
   reg:
@@ -37,6 +38,14 @@ properties:
   clock-names:
     const: mclk
 
+  firmware-name:
+    maxItems: 1
+    description:
+      Register script loaded right after the oscillator trim, in the text
+      format written by TI PurePath Console ("w <addr> <reg> <data>..."
+      lines, ">" continuation lines, "#" comments). It holds the complete
+      board tuning (DAP, EQ, DRC, output mixers and PWM mux).
+
   AVDD-supply: true
   DVDD-supply: true
   HPVDD-supply: true
@@ -99,6 +108,7 @@ allOf:
           contains:
             enum:
               - ti,tas5721
+              - ti,tas5751m
               - ti,tas5753
     then:
       properties:
