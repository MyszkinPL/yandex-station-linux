# Stage B initramfs (boot/pack.py, gen_init_cpio format), the same for every
# Station: nothing private in it.
#   ${BUILD}    CI output: busybox and kexec, built statically from source
#   ${MODULES}  CI output (scripts/build-kernel.sh): out/initramfs-modules, the
#               Wi-Fi, amplifier and Bluetooth drivers with a modules.dep
# The firmware those drivers need is Yandex's: init copies it at every boot
# from the Station's own Android (/system/vendor/...), checks it against the
# known hashes and loads the drivers then. SSH keys and a root password are
# the owner's, kept in /cache/station/persist/ssh (the installer puts them
# there), never in the image.
dir /dev 0755 0 0
nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
dir /bin 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /tmp 1777 0 0
dir /run 0755 0 0
dir /etc 0755 0 0
dir /etc/station 0755 0 0
dir /lib 0755 0 0
dir /lib/firmware 0755 0 0
dir /lib/firmware/brcm 0755 0 0
tree /lib/modules ${MODULES}/lib/modules
file /bin/busybox ${BUILD}/busybox 0755 0 0
file /bin/kexec ${BUILD}/kexec 0755 0 0
file /init init.sh 0755 0 0
file /udhcpc.sh udhcpc.sh 0755 0 0
file /etc/station/station-audio-init.sh station-audio-init.sh 0755 0 0
file /etc/station/station-mics-init.sh station-mics-init.sh 0755 0 0
# plain Debian's Wi-Fi page on its access point (init.sh: start_ap)
dir /www 0755 0 0
dir /www/cgi-bin 0755 0 0
file /www/index.html setup/index.html 0644 0 0
file /www/cgi-bin/wifi setup/wifi.cgi 0755 0 0
file /etc/httpd-setup.conf setup/httpd.conf 0644 0 0
