diff --git a/src/devicedrv/mali/linux/mali_osk_timers.c b/src/devicedrv/mali/linux/mali_osk_timers.c
index 628a9cf..1e434da 100644
--- a/src/devicedrv/mali/linux/mali_osk_timers.c
