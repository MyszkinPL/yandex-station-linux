From: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
Subject: [PATCH] mali: ask fences for their status the dma-fence way

Since Linux 4.9 the driver reads the state of a fence by calling
fence->ops->signaled() itself. That callback is optional: the stub fence
has none, and dma_fence_unwrap_merge() hands out the stub when every
fence it merges has already signaled, which is what a SurfaceFlinger
merge of two old fences gives. Such a fence was taken for one signaled
with error -1 ("sync fence fd .. signaled with error -1") and the job
waiting for it failed; in the other places it would be a NULL call.

Use dma_fence_get_status() there: 1 signaled, 0 pending, < 0 signaled
with an error, whatever ops the fence has.

Signed-off-by: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
---
--- a/src/devicedrv/mali/linux/mali_internal_sync.h
+++ b/src/devicedrv/mali/linux/mali_internal_sync.h
@@ -43,6 +43,13 @@
 #endif
 #endif
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 10, 0)
+/* 1 signaled, 0 pending, < 0 signaled with an error; ops->signaled is optional */
+#define mali_internal_fence_status(fence) dma_fence_get_status(fence)
+#elif LINUX_VERSION_CODE >= KERNEL_VERSION(4, 9, 0)
+#define mali_internal_fence_status(fence) ((fence)->ops->signaled(fence))
+#endif
+
 struct mali_internal_sync_timeline;
 struct mali_internal_sync_point;
 struct mali_internal_sync_fence;
--- a/src/devicedrv/mali/linux/mali_internal_sync.c
+++ b/src/devicedrv/mali/linux/mali_internal_sync.c
@@ -97,11 +97,11 @@
 	if (ret)
 		wake_up_all(&sync_fence->wq);
 #else
-	ret = sync_fence->fence->ops->signaled(sync_fence->fence);
+	ret = mali_internal_fence_status(sync_fence->fence);
 
 	if (0 > ret)
 		MALI_PRINT_ERROR(("Mali internal sync:Failed to wait fence  0x%x for sync_fence 0x%x.\n", fence, sync_fence));
-	if (1 == ret)
+	if (ret)
 		wake_up_all(&sync_fence->wq);
 #endif
 }
@@ -588,8 +588,8 @@
 
 	return !err;
 #else
-	if ((sync_fence->fence) && (sync_fence->fence->ops) && (sync_fence->fence->ops->signaled))
-		err = sync_fence->fence->ops->signaled(sync_fence->fence);
+	if (sync_fence->fence)
+		err = mali_internal_fence_status(sync_fence->fence);
 	else
 		err = -1;
 
@@ -614,7 +614,7 @@
 	waiter->work.private = sync_fence;
 
 	spin_lock_irqsave(&sync_fence->wq.lock, flags);
-	err =  sync_fence->fence->ops->signaled(sync_fence->fence);
+	err = mali_internal_fence_status(sync_fence->fence);
 
 	if (0 == err){
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 13, 0)
--- a/src/devicedrv/mali/common/mali_timeline.c
+++ b/src/devicedrv/mali/common/mali_timeline.c
@@ -1552,7 +1552,7 @@
 #elif LINUX_VERSION_CODE < KERNEL_VERSION(4, 9, 0)
 		fence_status = atomic_read(&sync_fence->status);
 #else
-		fence_status = sync_fence->fence->ops->signaled(sync_fence->fence);
+		fence_status = mali_internal_fence_status(sync_fence->fence);
 #endif
 
 		system = tracker->system;
--- a/src/devicedrv/mali/common/mali_timeline_fence_wait.c
+++ b/src/devicedrv/mali/common/mali_timeline_fence_wait.c
@@ -113,7 +113,7 @@
 #elif LINUX_VERSION_CODE < KERNEL_VERSION(4, 9, 0)
 			if (0 < atomic_read(&sync_fence->status)) {
 #else
-			if (0 == sync_fence->fence->ops->signaled(sync_fence->fence)) {
+			if (0 == mali_internal_fence_status(sync_fence->fence)) {
 #endif
 				ret = MALI_FALSE;
 
