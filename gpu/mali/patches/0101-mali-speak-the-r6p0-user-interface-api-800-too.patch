index 1d3c531..087c51f 100644
--- a/src/devicedrv/mali/common/mali_gp_job.c
+++ b/src/devicedrv/mali/common/mali_gp_job.c
@@ -19,6 +19,38 @@ static u32 gp_counter_src0 = MALI_HW_CORE_NO_COUNTER;      /**< Performance coun
 static u32 gp_counter_src1 = MALI_HW_CORE_NO_COUNTER;           /**< Performance counter 1, MALI_HW_CORE_NO_COUNTER for disabled */
 static void _mali_gp_del_varying_allocations(struct mali_gp_job *job);
 
+/* Read GP job arguments in the r6p0 layout (API 800), see mali_uk_r6p0.h */
+static int mali_gp_job_copy_r6p0_args(struct mali_gp_job *job, void __user *uargs)
+{
+	_mali_uk_gp_start_job_r6p0_s r6;
+	_mali_uk_gp_start_job_s *a = &job->uargs;
+
+	BUILD_BUG_ON(sizeof(_mali_uk_gp_start_job_r6p0_s) != 112);
+	if (0 != _mali_osk_copy_from_user(&r6, uargs, sizeof(r6)))
+		return -EFAULT;
+
+	a->ctx = r6.ctx;
+	a->user_job_ptr = r6.user_job_ptr;
+	a->priority = r6.priority;
+	memcpy(a->frame_registers, r6.frame_registers, sizeof(a->frame_registers));
+	a->perf_counter_flag = r6.perf_counter_flag;
+	a->perf_counter_src0 = r6.perf_counter_src0;
+	a->perf_counter_src1 = r6.perf_counter_src1;
+	a->frame_builder_id = r6.frame_builder_id;
+	a->flush_id = r6.flush_id;
+	a->fence = r6.fence;
+	a->timeline_point_ptr = r6.timeline_point_ptr;
+	a->varying_memsize = r6.varying_memsize;
+	a->deferred_mem_num = r6.deferred_mem_num;
+	a->deferred_mem_list = r6.deferred_mem_list;
+
+	/* the kernel grows the heap on OOM in whole MMU pages (mali_mem_add_mem_size()) */
+	if (0 != r6.heap_grow_size && 0 == r6.heap_grow_size % _MALI_OSK_MALI_PAGE_SIZE)
+		job->heap_grow_size = r6.heap_grow_size;
+	job->heap_base_addr = r6.frame_registers[4];
+	return 0;
+}
+
 
 static int _mali_gp_add_varying_allocations(struct mali_session_data *session,
 		struct mali_gp_job *job,
@@ -91,7 +123,10 @@ struct mali_gp_job *mali_gp_job_create(struct mali_session_data *session, _mali_
 			goto fail2;
 		}
 
-		if (0 != _mali_osk_copy_from_user(&job->uargs, uargs, sizeof(_mali_uk_gp_start_job_s))) {
+		if (mali_session_uses_r6p0_api(session)) {
+			if (0 != mali_gp_job_copy_r6p0_args(job, (void __user *)uargs))
+				goto fail1;
+		} else if (0 != _mali_osk_copy_from_user(&job->uargs, uargs, sizeof(_mali_uk_gp_start_job_s))) {
 			goto fail1;
 		}
 
