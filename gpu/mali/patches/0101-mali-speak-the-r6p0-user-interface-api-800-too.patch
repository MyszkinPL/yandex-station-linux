From: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
Subject: [PATCH] mali: speak the r6p0 user interface (API 800) too

User space built for r6p0, such as the libGLES_mali of the Yandex Station
firmware, asks for API 800 and is refused by this API 900 driver. The
two interfaces differ in three places only (mali_uk_r6p0.h):

- the GP job arguments have heap_grow_size after the frame registers
  (112 bytes instead of 104), and in r6p0 the kernel grows the PLBU heap:
  on out-of-memory it adds heap_grow_size to the heap allocation,
  resumes the job and reports heap_added_size in the stall notification
  (where API 900 has padding);
- the memory allocation arguments have no secure_shared_fd (32 bytes
  instead of 40).

A session now keeps the version it asked for and gets it reported back.
Since ioctl numbers encode the argument size, the r6p0 GP start and
memory allocation calls have their own numbers; each is refused (ENOTTY)
by a session of the other version. GP job arguments are read in the
session's layout in mali_gp_job_create(), which covers the combined PP
and GP start too.

The heap is grown on the Mali work queue (it allocates pages, which the
executor spinlock does not allow). The job is only looked at under the
lock, as it may time out meanwhile; the session stays valid because
_mali_ukk_close() flushes that queue before it frees session memory.
API 900 sessions behave exactly as before.

Signed-off-by: MyszkinPL <211237936+MyszkinPL@users.noreply.github.com>
---
diff --git a/src/devicedrv/mali/common/mali_executor.c b/src/devicedrv/mali/common/mali_executor.c
index da581f8..bb5febf 100644
--- a/src/devicedrv/mali/common/mali_executor.c
+++ b/src/devicedrv/mali/common/mali_executor.c
@@ -9,6 +9,7 @@
  */
 
 #include "mali_executor.h"
+#include "mali_memory_manager.h"
 #include "mali_scheduler.h"
 #include "mali_kernel_common.h"
 #include "mali_kernel_core.h"
@@ -127,7 +128,7 @@ static mali_bool mali_executor_has_virtual_group(void);
 static mali_bool mali_executor_virtual_group_is_usable(void);
 static void mali_executor_schedule(void);
 static void mali_executor_wq_schedule(void *arg);
-static void mali_executor_send_gp_oom_to_user(struct mali_gp_job *job);
+static void mali_executor_send_gp_oom_to_user(struct mali_gp_job *job, u32 heap_added_size);
 static void mali_executor_complete_group(struct mali_group *group,
 		mali_bool success,
 		struct mali_gp_job **gp_job_done,
@@ -582,11 +583,23 @@ _mali_osk_errcode_t mali_executor_interrupt_gp(struct mali_group *group,
 		mali_group_oom(group);
 #endif
 
+		if (mali_gp_job_kernel_grows_heap(job)) {
+			/*
+			 * r6p0 session: the kernel grows the heap, which may
+			 * sleep, so in mali_executor_group_oom()
+			 */
+			mali_gp_job_set_current_heap_addr(job,
+							  mali_gp_read_plbu_alloc_start_addr(group->gp_core));
+			_mali_osk_wq_schedule_work(group->oom_work_gp);
+			mali_executor_unlock();
+			return _MALI_OSK_ERR_OK;
+		}
+
 		/*
 		 * no need to hold interrupt raised while
 		 * waiting for more memory.
 		 */
-		mali_executor_send_gp_oom_to_user(job);
+		mali_executor_send_gp_oom_to_user(job, 0);
 
 		mali_executor_unlock();
 
@@ -1303,6 +1316,12 @@ _mali_osk_errcode_t _mali_ukk_gp_suspend_response(_mali_uk_gp_suspend_response_s
 								   args->arguments[0],
 								   args->arguments[1]);
 
+				/* r6p0: later growth extends the block user space gave */
+				if (mali_gp_job_kernel_grows_heap(job)) {
+					job->heap_base_addr = args->arguments[0];
+					job->heap_current_addr = args->arguments[0];
+				}
+
 				mali_executor_unlock();
 				return _MALI_OSK_ERR_OK;
 			} else {
@@ -1891,7 +1910,66 @@ static void mali_executor_wq_schedule(void *arg)
 	mali_executor_unlock();
 }
 
-static void mali_executor_send_gp_oom_to_user(struct mali_gp_job *job)
+/*
+ * PLBU out of heap memory in an r6p0 session (API 800): grow the heap
+ * allocation by the job's heap_grow_size and resume the job on the new
+ * block, as the r6p0 driver did, then tell user space how much was added.
+ * If the heap cannot grow, user space gets heap_added_size 0 and answers
+ * with _mali_ukk_gp_suspend_response() as in API 900.
+ *
+ * Runs on the Mali work queue: growing allocates pages, which the executor
+ * spinlock does not allow. The job may end meanwhile (timeout, abort), so
+ * it is only looked at under the lock; the session stays valid because
+ * _mali_ukk_close() flushes this queue before it frees session memory.
+ */
+void mali_executor_group_oom(struct mali_group *group)
+{
+	struct mali_session_data *session;
+	struct mali_gp_job *job;
+	u32 id, heap_base, heap_current, grow;
+	_mali_osk_notification_t *new_notification = NULL;
+	mali_bool grown;
+
+	mali_executor_lock();
+	job = mali_group_get_running_gp_job(group);
+	if (NULL == job || !mali_gp_job_kernel_grows_heap(job)) {
+		mali_executor_unlock();
+		return;
+	}
+	session = mali_gp_job_get_session(job);
+	id = mali_gp_job_get_id(job);
+	heap_base = job->heap_base_addr;
+	heap_current = mali_gp_job_get_current_heap_addr(job);
+	grow = job->heap_grow_size;
+	mali_executor_unlock();
+
+	grown = _MALI_OSK_ERR_OK == mali_mem_add_mem_size(session, heap_base, grow);
+	if (grown)
+		new_notification = _mali_osk_notification_create(_MALI_NOTIFICATION_GP_STALLED,
+								 sizeof(_mali_uk_gp_job_suspended_s));
+
+	mali_executor_lock();
+	job = mali_group_get_running_gp_job(group);
+	if (NULL == job || id != mali_gp_job_get_id(job)) {
+		mali_executor_unlock();
+		if (NULL != new_notification)
+			_mali_osk_notification_delete(new_notification);
+		return;
+	}
+
+	if (grown && NULL != new_notification) {
+		MALI_DEBUG_PRINT(3, ("Executor: grew the heap of GP job %u by %u bytes\n", id, grow));
+		mali_executor_send_gp_oom_to_user(job, grow);
+		mali_gp_job_set_oom_notification(job, new_notification);
+		/* This will also re-enable interrupts */
+		mali_group_resume_gp_with_new_heap(group, id, heap_current, heap_current + grow);
+	} else {
+		mali_executor_send_gp_oom_to_user(job, 0);
+	}
+	mali_executor_unlock();
+}
+
+static void mali_executor_send_gp_oom_to_user(struct mali_gp_job *job, u32 heap_added_size)
 {
 	_mali_uk_gp_job_suspended_s *jobres;
 	_mali_osk_notification_t *notification;
@@ -1907,6 +1985,9 @@ static void mali_executor_send_gp_oom_to_user(struct mali_gp_job *job)
 	jobres = (_mali_uk_gp_job_suspended_s *)notification->result_buffer;
 	jobres->user_job_ptr = mali_gp_job_get_user_id(job);
 	jobres->cookie = gp_returned_cookie;
+	/* r6p0 sessions read it; in API 900 this is padding */
+	BUILD_BUG_ON(sizeof(_mali_uk_gp_job_suspended_r6p0_s) != sizeof(_mali_uk_gp_job_suspended_s));
+	((_mali_uk_gp_job_suspended_r6p0_s *)jobres)->heap_added_size = heap_added_size;
 
 	mali_session_send_notification(mali_gp_job_get_session(job),
 				       notification);
