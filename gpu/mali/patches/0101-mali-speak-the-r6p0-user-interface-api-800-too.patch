diff --git a/src/devicedrv/mali/common/mali_uk_r6p0.h b/src/devicedrv/mali/common/mali_uk_r6p0.h
new file mode 100644
index 0000000..9cb9bf8
--- /dev/null
+++ b/src/devicedrv/mali/common/mali_uk_r6p0.h
@@ -0,0 +1,62 @@
+/*
+ * User/kernel interface of the r6p0 releases (API 800), next to the native
+ * r10p0 one (API 900), so that user space built for r6p0 runs unmodified
+ * on this driver; the Yandex Station ships such a libGLES_mali.
+ *
+ * API 800 differs from 900 in three places only:
+ *  - _mali_uk_gp_start_job_s has heap_grow_size after the frame registers
+ *    (112 bytes instead of 104), and the PLBU heap is grown by the kernel:
+ *    on out-of-memory it adds heap_grow_size to the heap allocation,
+ *    resumes the job itself and tells user space how much it added;
+ *  - _mali_uk_gp_job_suspended_s carries that heap_added_size (in what is
+ *    padding in API 900, so the notification has the same size);
+ *  - _mali_uk_alloc_mem_s has no secure_shared_fd (32 bytes instead of 40).
+ * The ioctl numbers encode the argument size, so the two GP start and
+ * memory allocation calls have numbers of their own. A session speaks the
+ * version it asked for in _mali_ukk_get_api_version(_v2)().
+ */
+#ifndef __MALI_UK_R6P0_H__
+#define __MALI_UK_R6P0_H__
+
+#include <linux/mali/mali_utgard_uk_types.h>
+#include <linux/mali/mali_utgard_ioctl.h>
+
+#define _MALI_UK_API_VERSION_R6P0 _MAKE_VERSION_ID(800)
+
+typedef struct {
+	u64 ctx;
+	u64 user_job_ptr;
+	u32 priority;
+	u32 frame_registers[MALIGP2_NUM_REGS_FRAME];
+	u32 heap_grow_size;
+	u32 perf_counter_flag;
+	u32 perf_counter_src0;
+	u32 perf_counter_src1;
+	u32 frame_builder_id;
+	u32 flush_id;
+	_mali_uk_fence_t fence;
+	u64 timeline_point_ptr;
+	u32 varying_memsize;
+	u32 deferred_mem_num;
+	u64 deferred_mem_list;
+} _mali_uk_gp_start_job_r6p0_s;
+
+typedef struct {
+	u64 user_job_ptr;
+	u32 cookie;
+	u32 heap_added_size;
+} _mali_uk_gp_job_suspended_r6p0_s;
+
+typedef struct {
+	u64 ctx;
+	u32 gpu_vaddr;
+	u32 vsize;
