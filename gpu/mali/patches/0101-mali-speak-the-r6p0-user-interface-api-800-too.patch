+	return 0 != job->heap_grow_size;
+}
+
 MALI_STATIC_INLINE u32 mali_gp_job_get_current_heap_addr(struct mali_gp_job *job)
 {
 	MALI_DEBUG_ASSERT_POINTER(job);
