+/* The r6p0 layout (API 800): no secure memory, see mali_uk_r6p0.h */
+int mem_alloc_r6p0_wrapper(struct mali_session_data *session_data, _mali_uk_alloc_mem_r6p0_s __user *uargs)
+{
+	_mali_uk_alloc_mem_r6p0_s r6;
+	_mali_uk_alloc_mem_s kargs = { 0 };
+	_mali_osk_errcode_t err;
+
+	BUILD_BUG_ON(sizeof(_mali_uk_alloc_mem_r6p0_s) != 32);
+	MALI_CHECK_NON_NULL(uargs, -EINVAL);
+	MALI_CHECK_NON_NULL(session_data, -EINVAL);
+
+	if (!mali_session_uses_r6p0_api(session_data))
+		return -ENOTTY;
+	if (0 != copy_from_user(&r6, uargs, sizeof(r6)))
+		return -EFAULT;
+	if (r6.flags & _MALI_MEMORY_ALLOCATE_SECURE)
+		return -EINVAL;
+
+	kargs.ctx = (uintptr_t)session_data;
+	kargs.gpu_vaddr = r6.gpu_vaddr;
+	kargs.vsize = r6.vsize;
+	kargs.psize = r6.psize;
+	kargs.flags = r6.flags;
+	kargs.backend_handle = r6.backend_handle;   /* handed back as it came, as both releases do */
+	kargs.secure_shared_fd = -1;
+
+	err = _mali_ukk_mem_allocate(&kargs);
+	if (_MALI_OSK_ERR_OK != err)
+		return map_errcode(err);
+
+	if (0 != put_user(kargs.backend_handle, &uargs->backend_handle))
+		return -EFAULT;
+
+	return 0;
+}
